rules_version = '2';
// Do databáze přistupuje VÝHRADNĚ server (Firebase Admin SDK obchází pravidla).
// Z prohlížeče je přístup zakázaný úplně — nikdo nemůže číst objednávky ani měnit ceny.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
